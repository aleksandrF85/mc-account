<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1743017452269-1" author="alfr9 (generated)">
        <createTable tableName="account">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_account"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(255)"/>
            <column name="photo" type="VARCHAR(255)"/>
            <column name="about" type="VARCHAR(255)"/>
            <column name="city" type="VARCHAR(255)"/>
            <column name="country" type="VARCHAR(255)"/>
            <column name="token" type="VARCHAR(255)"/>
            <column name="status_code" type="VARCHAR(255)"/>
            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="reg_date" type="timestamp"/>
            <column name="birth_date" type="timestamp"/>
            <column name="message_permission" type="VARCHAR(255)"/>
            <column name="last_online_time" type="timestamp"/>
            <column name="is_online" type="BOOLEAN"/>
            <column name="is_blocked" type="BOOLEAN"/>
            <column name="is_deleted" type="BOOLEAN"/>
            <column name="photo_id" type="VARCHAR(255)"/>
            <column name="photo_name" type="VARCHAR(255)"/>
            <column name="created_on" type="timestamp"/>
            <column name="updated_on" type="timestamp"/>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1743017452269-2" author="alfr9 (generated)">
        <createTable tableName="user_roles">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="roles" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1743017452269-3" author="alfr9 (generated)">
        <addUniqueConstraint columnNames="email" constraintName="uc_account_email" tableName="account"/>
    </changeSet>
    <changeSet id="1743017452269-4" author="alfr9 (generated)">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="user_roles"
                                 constraintName="fk_user_roles_on_account" referencedColumnNames="id"
                                 referencedTableName="account"/>
    </changeSet>

</databaseChangeLog>